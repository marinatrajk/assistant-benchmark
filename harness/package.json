{
  "name": "paces-local-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A small local agent harness with browser, desktop, memory, and skills.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "setup": "node scripts/setup.js",
    "test": "node --test test/*.test.js",
    "test:browser": "node --test test/browser.integration.js",
    "check": "node scripts/check.js",
    "test:ui": "node --test test/ui.integration.js"
  },
  "dependencies": {
    "playwright": "1.63.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/marinatrajk/assistant-benchmark.git",
    "directory": "harness"
  }
}
